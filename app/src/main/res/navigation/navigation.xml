<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/bootUpFragment">

    <!-- The boot up fragment -->
    <fragment
        android:id="@+id/bootUpFragment"
        android:name="adco.helixsongview.appdata.BootUpFragment"
        android:label="bootup_logo"
        tools:layout="@layout/bootup_logo">
        <deepLink android:id="@+id/deepLinkBoot"
            app:uri="@string/deeplink_bootup"/>
        <action
            android:id="@+id/action_bootUpFragment_to_performanceFragment"
            app:destination="@id/performanceFragment" />
        <action
            android:id="@+id/action_global_setStorageLocationFragment"
            app:destination="@id/setStorageLocationFragment"/>
    </fragment>


    <!-- The performance fragment -->
    <fragment
        android:id="@+id/performanceFragment"
        android:name="adco.helixsongview.performance.PerformanceFragment"
        android:label="fragment_performance"
        tools:layout="@layout/mode_performance">
        <action
            android:id="@+id/action_performanceFragment_to_preferences_graph"
            app:destination="@id/preferences_graph" />
        <action
            android:id="@+id/action_performanceFragment_to_editsong_graph"
            app:destination="@id/editsong_graph" />
        <action
            android:id="@+id/action_performanceFragment_to_import_graph"
            app:destination="@id/import_graph" />
        <deepLink
            android:id="@+id/deepLinkPerformance"
            app:uri="@string/deeplink_performance" />
        <action
            android:id="@+id/action_performanceFragment_to_alertInfoDialogFragment"
            app:destination="@+id/alertInfoDialogFragment" />
        <action
            android:id="@+id/action_performanceFragment_to_songMenuFragment"
            app:destination="@id/song_menu_graph" />
        <action
            android:id="@+id/action_performanceFragment_to_set_menu_graph"
            app:destination="@id/set_menu_graph" />
        <action
            android:id="@+id/action_ImportIOS"
            app:destination="@+id/importIOSFragment" />
    </fragment>

    <!-- The presenter fragment -->

    <!-- The preferences graph -->
    <navigation
        android:id="@+id/preferences_graph"
        app:startDestination="@id/preferencesFragment">

        <!-- The main preferences fragment -->
        <fragment
            android:id="@+id/preferencesFragment"
            android:name="adco.helixsongview.preferences.SettingsCategories"
            android:label="settings_categories"
            tools:layout="@layout/settings_categories">
            <action
                android:id="@+id/action_preferencesFragment_to_nearbyConnectionsFragment"
                app:destination="@id/nearbyConnectionsFragment" />
            <action
                android:id="@+id/action_preferencesFragment_to_storage_graph"
                app:destination="@id/storage_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_display_graph"
                app:destination="@id/display_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_midiFragment"
                app:destination="@id/midi_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_profileFragment"
                app:destination="@id/profileFragment" />
            <action
                android:id="@+id/action_preferencesFragment_to_control_graph"
                app:destination="@id/control_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_about_graph"
                app:destination="@id/about_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_actions_graph"
                app:destination="@id/actions_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_modeFragment"
                app:destination="@id/modeFragment" />
            <action
                android:id="@+id/action_import_graph"
                app:destination="@id/import_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_set_graph"
                app:destination="@id/set_graph" />
            <action
                android:id="@+id/action_preferencesFragment_to_webServerFragment"
                app:destination="@id/webServerFragment" />
            <action
                android:id="@+id/action_preferencesFragment_to_syncNearbyFragment"
                app:destination="@id/syncNearbyFragment" />
            <action
                android:id="@+id/action_preferencesFragment_to_searchMenuFragment"
                app:destination="@id/searchMenuFragment" />

        </fragment>

        <!-- The storage graph -->
        <navigation
            android:id="@+id/storage_graph"
            app:startDestination="@id/storageOptionsFragment">

            <!-- The storage layout fragment -->
            <fragment
                android:id="@+id/storageManagementFragment"
                android:name="adco.helixsongview.filemanagement.StorageManagementFragment"
                android:label="storage_folder_display"
                tools:layout="@layout/storage_folder_display">
                <action
                    android:id="@+id/action_storageManagementFragment_to_setStorageLocationFragment"
                    app:destination="@id/setStorageLocationFragment" />
                <action
                    android:id="@+id/action_storageManagementFragment_to_backupOSBFragment"
                    app:destination="@id/backupOSBFragment" />
                <action
                    android:id="@+id/action_storageManagementFragment_to_moveContentDialog"
                    app:destination="@id/moveContentFragment" />
                <deepLink
                    android:id="@+id/deepLinkManageStorage"
                    app:uri="@string/deeplink_manage_storage"/>
            </fragment>

            <!-- Choose the storage fragment -->
            <fragment
                android:id="@+id/setStorageLocationFragment"
                android:name="adco.helixsongview.filemanagement.SetStorageLocationFragment"
                android:label="fragment_setstoragelocation"
                tools:layout="@layout/storage_choose">
                <deepLink
                    android:id="@+id/deepLinkSetStorage"
                    app:uri="@string/deeplink_set_storage" />
                <action
                    android:id="@+id/action_setStorageLocationFragment_to_kitKatFolderChoose"
                    app:destination="@id/kitKatFolderChoose" />
            </fragment>

            <!-- The options fragment -->
            <fragment
                android:id="@+id/storageOptionsFragment"
                android:name="adco.helixsongview.filemanagement.StorageOptionsFragment"
                android:label="fragment_storageoption"
                tools:layout="@layout/settings_storage_options">
                <deepLink
                    android:id="@+id/deepLinkStorageOptions"
                    app:uri="@string/deeplink_storage_options" />
                <action
                    android:id="@+id/action_storageOptionsFragment_to_storageManagementFragment"
                    app:destination="@id/storageManagementFragment" />
                <action
                    android:id="@+id/action_storageOptionsFragment_to_openChordsFragment"
                    app:destination="@id/openChordsFragment" />
                <action
                    android:id="@+id/action_storageOptionsFragment_to_syncNearbyFragment"
                    app:destination="@id/syncNearbyFragment" />
            </fragment>

            <!-- The Sync with Nearby fragment -->
            <fragment
                android:id="@+id/syncNearbyFragment"
                android:name="adco.helixsongview.nearby.SyncNearbyFragment"
                android:label="BrowseHostFiles"
                tools:layout="@layout/settings_sync">
                <deepLink
                    android:id="@+id/deepLinkSync"
                    app:uri="@string/deeplink_sync" />
            </fragment>

            <!-- The OpenChords fragment -->
            <fragment
                android:id="@+id/openChordsFragment"
                android:name="adco.helixsongview.openchords.OpenChordsFragment"
                android:label="OpenChordsFragment"
                tools:layout="@layout/settings_openchords">
                <deepLink
                    android:id="@+id/deeplinkOpenChords"
                    app:uri="@string/deeplink_openchords"/>
            </fragment>

            <fragment
                android:id="@+id/kitKatFolderChoose"
                android:name="adco.helixsongview.filemanagement.KitKatFolderChooseFragment"
                android:label="storage_kitkat_choose"
                tools:layout="@layout/storage_kitkat_chooser">
                <deepLink
                    android:id="@+id/deepLinkKitKat"
                    app:uri="@string/deeplink_kitkat_choose" />
            </fragment>
            <!-- Choose the storage fragment -->
            <fragment
                android:id="@+id/backupOSBFragment"
                android:name="adco.helixsongview.backupandrestore.BackupOSBFragment"
                android:label="fragment_osbbackup"
                tools:layout="@layout/storage_backup">
                <deepLink
                    android:id="@+id/deepLinkBackup"
                    app:uri="@string/deeplink_backup" />
            </fragment>

            <fragment
                android:id="@+id/moveContentFragment"
                android:name="adco.helixsongview.filemanagement.MoveContentFragment"
                android:label="MoveContentDialog"
                tools:layout="@layout/storage_move">
                <deepLink android:id="@+id/deepLinkMove"
                    app:uri="@string/deeplink_move"/>
            </fragment>

        </navigation>

        <!-- Google Nearby -->
        <fragment
            android:id="@+id/nearbyConnectionsFragment"
            android:name="adco.helixsongview.nearby.NearbyConnectionsFragment"
            android:label="settings_nearbyconnections"
            tools:layout="@layout/settings_nearbyconnections">
            <deepLink
                android:id="@+id/deepLinkNearby"
                app:uri="@string/deeplink_nearby" />
        </fragment>

        <!-- Display graph -->
        <navigation
            android:id="@+id/display_graph"
            app:startDestination="@+id/displayMenuFragment">

            <!-- Display fragment -->
            <fragment
                android:id="@+id/displayMenuFragment"
                android:name="adco.helixsongview.screensetup.DisplayMenuFragment"
                android:label="settings_display"
                tools:layout="@layout/settings_display">
                <deepLink
                    android:id="@+id/deepLinkDisplay"
                    app:uri="@string/deeplink_display" />
                <action
                    android:id="@+id/action_displayMenuFragment_to_fontSetupFragment"
                    app:destination="@id/fontSetupFragment" />
                <action
                    android:id="@+id/action_displayMenuFragment_to_actionBarSettingsFragment"
                    app:destination="@id/actionBarSettingsFragment" />
                <action
                    android:id="@+id/action_displayMenuFragment_to_menuSettingsFragment"
                    app:destination="@id/menuSettingsFragment" />
                <action
                    android:id="@+id/action_displayMenuFragment_to_displayExtraFragment"
                    app:destination="@id/displayExtraFragment" />
                <action
                    android:id="@+id/action_displayMenuFragment_to_displayScalingFragment"
                    app:destination="@id/displayScalingFragment" />
                <action
                    android:id="@+id/action_displayMenuFragment_to_inlineSetFragment"
                    app:destination="@id/inlineSetFragment" />
                <action
                    android:id="@+id/action_displayMenuFragment_to_marginsFragment"
                    app:destination="@id/marginsFragment" />
            </fragment>

            <!-- Theme fragment -->
            <fragment
                android:id="@+id/themeSetupFragment"
                android:name="adco.helixsongview.screensetup.ThemeSetupFragment"
                android:label="settings_theme"
                tools:layout="@layout/settings_theme">
            </fragment>

            <!-- Colour chooser -->
            <dialog
                android:id="@+id/chooseColorBottomSheet"
                android:name="adco.helixsongview.screensetup.ChooseColorBottomSheet"
                android:label="display_color_settings"
                tools:layout="@layout/bottom_sheet_choose_color" />

            <!-- Font chooser -->
            <fragment
                android:id="@+id/fontSetupFragment"
                android:name="adco.helixsongview.screensetup.FontSetupFragment"
                android:label="settings_fonts"
                tools:layout="@layout/settings_fonts">
                <action
                    android:id="@+id/action_fontSetupFragment_to_fontSetupPreviewFragment"
                    app:destination="@id/fontSetupPreviewFragment" />
                <deepLink
                    android:id="@+id/deepLinkFonts"
                    app:uri="@string/deeplink_fonts" />
            </fragment>

            <!-- Font preview -->
            <fragment
                android:id="@+id/fontSetupPreviewFragment"
                android:name="adco.helixsongview.screensetup.FontSetupPreviewFragment"
                android:label="settings_fonts_preview"
                tools:layout="@layout/settings_fonts_preview" />
            <fragment
                android:id="@+id/actionBarSettingsFragment"
                android:name="adco.helixsongview.screensetup.ActionBarSettingsFragment"
                android:label="settings_actionbar"
                tools:layout="@layout/settings_actionbar">
                <deepLink
                    android:id="@+id/deepLinkActionBar"
                    app:uri="@string/deeplink_actionbar" />
            </fragment>
            <fragment
                android:id="@+id/menuSettingsFragment"
                android:name="adco.helixsongview.screensetup.MenuSettingsFragment"
                android:label="MenuSettingsFragment"
                tools:layout="@layout/settings_menu">
                <deepLink
                    android:id="@+id/deepLinkMenu"
                    app:uri="@string/deeplink_menu_settings" />
            </fragment>
            <fragment
                android:id="@+id/displayExtraFragment"
                android:name="adco.helixsongview.screensetup.DisplayExtraFragment"
                android:label="DisplayExtraFragment"
                tools:layout="@layout/settings_display_extra">
                <deepLink
                    android:id="@+id/deepLinkDisplayExtra"
                    app:uri="@string/deeplink_display_extra" />
            </fragment>
            <fragment
                android:id="@+id/displayScalingFragment"
                android:name="adco.helixsongview.screensetup.DisplayScalingFragment"
                android:label="DisplayScalingFragment"
                tools:layout="@layout/settings_display_scaling">
                <deepLink
                    android:id="@+id/deepLinkScaling"
                    app:uri="@string/deeplink_scaling" />
            </fragment>



            <fragment
                android:id="@+id/inlineSetFragment"
                android:name="adco.helixsongview.setmenu.InlineSetFragment"
                android:label="settings_display_inline_set"
                tools:layout="@layout/settings_sets_inline">
                <deepLink
                    android:id="@+id/deepLinkInlineSet"
                    app:uri="@string/deeplink_inlineset" />
            </fragment>
            <fragment
                android:id="@+id/marginsFragment"
                android:name="adco.helixsongview.screensetup.MarginsFragment"
                android:label="settings_margins"
                tools:layout="@layout/settings_margins">
                <deepLink
                    android:id="@+id/deepLinkMargins"
                    app:uri="@string/deeplink_margins" />
            </fragment>

        </navigation>

        <!-- Midi -->

        <!-- Profiles -->
        <fragment
            android:id="@+id/profileFragment"
            android:name="adco.helixsongview.preferences.ProfileFragment"
            android:label="settings_profiles"
            tools:layout="@layout/settings_profiles">
            <deepLink
                android:id="@+id/deepLinkProfiles"
                app:uri="@string/deeplink_profiles" />
        </fragment>

        <!-- Controls graph -->
        <navigation
            android:id="@+id/control_graph"
            app:startDestination="@id/controlMenuFragment">

            <!-- Control options -->
            <fragment
                android:id="@+id/controlMenuFragment"
                android:name="adco.helixsongview.controls.ControlMenuFragment"
                android:label="settings_control"
                tools:layout="@layout/settings_control">
                <action
                    android:id="@+id/action_controlMenuFragment_to_pedalsFragment"
                    app:destination="@id/pedalsFragment" />
                <deepLink
                    android:id="@+id/deepLinkControls"
                    app:uri="@string/deeplink_controls" />
                <action
                    android:id="@+id/action_controlMenuFragment_to_pageButtonFragment"
                    app:destination="@id/pageButtonFragment" />
                <action
                    android:id="@+id/action_controlMenuFragment_to_gesturesFragment"
                    app:destination="@id/gesturesFragment" />
                <action
                    android:id="@+id/action_controlMenuFragment_to_swipeFragment"
                    app:destination="@id/swipeFragment" />
                <action
                    android:id="@+id/action_controlMenuFragment_to_hotZonesSettingsFragment"
                    app:destination="@id/hotZonesSettingsFragment" />
            </fragment>

            <!-- Pedal settings -->
            <fragment
                android:id="@+id/pedalsFragment"
                android:name="adco.helixsongview.controls.PedalsFragment"
                android:label="settings_pedal"
                tools:layout="@layout/settings_pedal">
                <deepLink
                    android:id="@+id/deepLinkPedals"
                    app:uri="@string/deeplink_pedals" />
            </fragment>
            <fragment
                android:id="@+id/pageButtonFragment"
                android:name="adco.helixsongview.controls.PageButtonFragment"
                android:label="PageButtonFragment"
                tools:layout="@layout/settings_pagebuttons">
                <deepLink
                    android:id="@+id/deepLinkPageButtons"
                    app:uri="@string/deeplink_page_buttons" />
            </fragment>
            <fragment
                android:id="@+id/gesturesFragment"
                android:name="adco.helixsongview.controls.GesturesFragment"
                android:label="GesturesFragment"
                tools:layout="@layout/settings_gestures">
                <deepLink
                    android:id="@+id/deepLinkGestures"
                    app:uri="@string/deeplink_gestures" />
            </fragment>
            <fragment
                android:id="@+id/swipeFragment"
                android:name="adco.helixsongview.controls.SwipeFragment"
                android:label="SwipeFragment"
                tools:layout="@layout/settings_swipes">
                <deepLink
                    android:id="@+id/deepLinkSwipe"
                    app:uri="@string/deeplink_swipe" />
            </fragment>
            <fragment
                android:id="@+id/hotZonesSettingsFragment"
                android:name="adco.helixsongview.controls.HotZonesSettingsFragment"
                android:label="HotZonesSettingsFragment"
                tools:layout="@layout/settings_hot_zones">
                <deepLink
                    android:id="@+id/deepLinkHotZones"
                    app:uri="@string/website_hot_zones"/>
            </fragment>

        </navigation>

        <!-- About graph -->
        <navigation
            android:id="@+id/about_graph"
            app:startDestination="@id/aboutAppFragment">

            <!-- About options -->
            <fragment
                android:id="@+id/aboutAppFragment"
                android:name="adco.helixsongview.appdata.AboutAppFragment"
                android:label="settings_about"
                tools:layout="@layout/settings_about">
                <deepLink
                    android:id="@+id/deepLinkAbout"
                    app:uri="@string/deeplink_about" />
                <action
                    android:id="@+id/action_aboutAppFragment_to_languageFragment"
                    app:destination="@id/languageFragment" />
                <action
                    android:id="@+id/action_aboutAppFragment_to_shareLogsFragment"
                    app:destination="@id/shareLogsFragment" />

            </fragment>

            <!-- Language -->
            <fragment
                android:id="@+id/languageFragment"
                android:name="adco.helixsongview.appdata.LanguageFragment"
                android:label="settings_language"
                tools:layout="@layout/settings_language">
                <deepLink
                    android:id="@+id/deepLinkLanguage"
                    app:uri="@string/deeplink_language" />
            </fragment>


            <!-- Share logs -->
            <fragment
                android:id="@+id/shareLogsFragment"
                android:name="adco.helixsongview.appdata.ShareLogsFragment"
                android:label="ShareLogsFragment"
                tools:layout="@layout/settings_share_logs">
                <deepLink
                    android:id="@+id/deepLinkShareLogs"
                    app:uri="@string/deeplink_logs" />
            </fragment>



        </navigation>
        <deepLink
            android:id="@+id/deepLinkPreferences"
            app:uri="@string/deeplink_preferences" />


        <!--Song actions graph -->
        <navigation android:id="@+id/actions_graph"
            app:startDestination="@id/songActionsMenuFragment">

            <fragment
                android:id="@+id/songActionsMenuFragment"
                android:name="adco.helixsongview.songprocessing.SongActionsMenuFragment"
                android:label="SongActionsMenuFragment"
                tools:layout="@layout/settings_songactions">
                <action
                    android:id="@+id/action_songActionsMenuFragment_to_editSongFragment"
                    app:destination="@+id/editsong_graph" />

                <deepLink
                    android:id="@+id/deepLinkSongActions"
                    app:uri="@string/deeplink_song_actions" />
                <action
                    android:id="@+id/action_songActionsMenuFragment_to_exportFragment"
                    app:destination="@id/exportFragment" />
                <action
                    android:id="@+id/action_songActionsMenuFragment_to_linksFragment"
                    app:destination="@id/linksFragment" />
                <action
                    android:id="@+id/action_songActionsMenuFragment_to_chords_graph"
                    app:destination="@id/chords_graph" />
                <action
                    android:id="@+id/action_songActionsMenuFragment_to_pads_graph"
                    app:destination="@id/pads_graph" />
                <action
                    android:id="@+id/action_songActionsMenuFragment_to_import_graph"
                    app:destination="@id/import_graph" />
                <action
                    android:id="@+id/action_songActionsMenuFragment_to_autoscrollSettingsFragment"
                    app:destination="@id/autoscrollSettingsFragment" />

           </fragment>




            <fragment
                android:id="@+id/exportFragment"
                android:name="adco.helixsongview.export.ExportFragment"
                android:label="ExportFragment"
                tools:layout="@layout/settings_export">
                <deepLink
                    android:id="@+id/deepLinkExport"
                    app:uri="@string/deeplink_export" />
            </fragment>
            <fragment
                android:id="@+id/linksFragment"
                android:name="adco.helixsongview.links.LinksFragment"
                android:label="LinksFragment"
                tools:layout="@layout/settings_links">
                <deepLink
                    android:id="@+id/deepLinkLinks"
                    app:uri="@string/deeplink_links" />
                <action
                    android:id="@+id/action_linksFragment_to_linksBottomSheet"
                    app:destination="@id/linksBottomSheet" />
            </fragment>
            <dialog
                android:id="@+id/linksBottomSheet"
                android:name="adco.helixsongview.links.LinksBottomSheet"
                android:label="LinksBottomSheet"
                tools:layout="@layout/bottom_sheet_links"/>
            <navigation android:id="@+id/chords_graph"
                app:startDestination="@id/chordSettingsFragment">
                <fragment
                    android:id="@+id/chordSettingsFragment"
                    android:name="adco.helixsongview.chords.ChordSettingsFragment"
                    android:label="ChordSettingsFragment"
                    tools:layout="@layout/settings_chords">
                    <action
                        android:id="@+id/action_chordSettingsFragment_to_chordFormatFragment"
                        app:destination="@id/chordFormatFragment" />
                    <action
                        android:id="@+id/action_chordSettingsFragment_to_customChordsFragment"
                        app:destination="@id/customChordsFragment" />
                    <deepLink
                        android:id="@+id/deepLinkChords"
                        app:uri="@string/deeplink_chords" />
                </fragment>
                <fragment
                    android:id="@+id/chordFormatFragment"
                    android:name="adco.helixsongview.chords.ChordFormatFragment"
                    android:label="ChordFormatFragment"
                    tools:layout="@layout/settings_chords_format">
                <deepLink
                    android:id="@+id/deepLinkChordSettings"
                    app:uri="@string/deeplink_chords_settings" />
                </fragment>
                <fragment
                    android:id="@+id/customChordsFragment"
                    android:name="adco.helixsongview.chords.CustomChordsFragment"
                    android:label="CustomChordsFragment"
                    tools:layout="@layout/settings_chords_custom">
                    <deepLink
                        android:id="@+id/deepLinkChordsCustom"
                        app:uri="@string/deeplink_chords_custom" />
                </fragment>

            </navigation>
            <navigation android:id="@+id/pads_graph"
                app:startDestination="@id/padSettingsFragment">
                <fragment
                    android:id="@+id/padSettingsFragment"
                    android:name="adco.helixsongview.backingtracks.PadSettingsFragment"
                    android:label="PadSettingsFragment"
                    tools:layout="@layout/settings_pads">
                    <action
                        android:id="@+id/action_padSettingsFragment_to_customPadsFragment"
                        app:destination="@id/customPadsFragment" />
                    <action
                        android:id="@+id/action_padSettingsFragment_to_padDefaultsFragment"
                        app:destination="@id/padDefaultsFragment" />
                    <deepLink
                        android:id="@+id/deepLinkPads"
                        app:uri="@string/deeplink_pads" />
                </fragment>
                <fragment
                    android:id="@+id/customPadsFragment"
                    android:name="adco.helixsongview.backingtracks.CustomPadsFragment"
                    android:label="CustomPadsFragment"
                    tools:layout="@layout/settings_pads_custom"/>
                <fragment
                    android:id="@+id/padDefaultsFragment"
                    android:name="adco.helixsongview.backingtracks.PadDefaultsFragment"
                    android:label="PadDefaultsFragment"
                    tools:layout="@layout/settings_pads_defaults"/>
            </navigation>

            <!-- Import options -->
            <navigation
                android:id="@+id/import_graph"
                app:startDestination="@id/importOptionsFragment">
                <deepLink
                    android:id="@+id/deepLinkImport"
                    app:uri="@string/deeplink_import" />


                <!-- The import options fragment -->
                <fragment
                    android:id="@+id/importOptionsFragment"
                    android:name="adco.helixsongview.importsongs.ImportOptionsFragment"
                    android:label="settings_import"
                    tools:layout="@layout/settings_import">
                    <action
                        android:id="@+id/action_importOptionsFragment_to_importOSBFragment"
                        app:destination="@id/importOSBFragment" />
                    <action
                        android:id="@+id/action_importOptionsFragment_to_importOnlineFragment"
                        app:destination="@id/importOnlineFragment" />
                    <action
                        android:id="@+id/action_importOptionsFragment_to_importFileFragment"
                        app:destination="@id/importFileFragment" />
                    <action
                        android:id="@+id/action_importOptionsFragment_to_importBulkFragment"
                        app:destination="@id/importBulkFragment" />
                    <action
                        android:id="@+id/action_importOptionsFragment_to_importIOSFragment"
                        app:destination="@id/importIOSFragment" />
                </fragment>

                <!-- OSB Import -->
                <fragment
                    android:id="@+id/importOSBFragment"
                    android:name="adco.helixsongview.backupandrestore.ImportOSBFragment"
                    android:label="fragment_osbbackup"
                    tools:layout="@layout/storage_backup">
                    <deepLink
                        android:id="@+id/deepLinkImportOSB"
                        app:uri="@string/deeplink_import_osb"/>
                </fragment>

                <fragment
                    android:id="@+id/importOnlineFragment"
                    android:name="adco.helixsongview.importsongs.ImportOnlineFragment"
                    android:label="ImportOnlineFragment"
                    tools:layout="@layout/settings_import_online">
                    <deepLink
                        android:id="@+id/deepLinkImportOnline"
                        app:uri="@string/deeplink_import_online"/>
                </fragment>
                <fragment
                    android:id="@+id/importFileFragment"
                    android:name="adco.helixsongview.importsongs.ImportFileFragment"
                    android:label="ImportFileFragment"
                    tools:layout="@layout/settings_import_file">
                    <deepLink
                        android:id="@+id/deeplink_import_file"
                        app:uri="@string/deeplink_import_file"/>

                </fragment>
                <fragment
