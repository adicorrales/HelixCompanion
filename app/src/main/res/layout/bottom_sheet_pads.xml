<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <adco.helixsongview.customviews.DialogHeader
        android:id="@+id/dialogHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pad" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/extra_scroll_space">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <adco.helixsongview.customviews.MyExtendedFloatingActionButton
                        android:id="@+id/startStopPad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:text="@string/start"
                        app:icon="@drawable/play" />
                </FrameLayout>

                <adco.helixsongview.customviews.MyExtendedFloatingActionButton
                    android:id="@+id/padPanic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/panic"
                    app:icon="@drawable/information"/>
            </LinearLayout>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/padKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="start"
                android:gravity="start"
                android:hint="@string/key" />

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/padType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="start"
                android:gravity="start"
                android:hint="@string/pad_onoroff" />

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/padLinkAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:hint="@string/link_audio"
                android:layout_gravity="start"
                android:gravity="start"
                android:inputType="none" />

            <adco.helixsongview.customviews.MyMaterialSwitch
                android:id="@+id/padLoop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="start"
                android:gravity="start"
                android:text="@string/loop" />

            <adco.helixsongview.customviews.MyMaterialButton
                android:id="@+id/padSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>