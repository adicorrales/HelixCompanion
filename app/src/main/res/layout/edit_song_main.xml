<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <adco.helixsongview.customviews.ScrollViewWithFAB
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <LinearLayout
            android:id="@+id/resizeForKeyboardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingBottom="@dimen/extra_scroll_space_large">

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/title"
                app:endIconMode="clear_text" />

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/artist"
                app:endIconMode="clear_text" />

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/copyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/copyright"
                app:endIconMode="clear_text" />
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="top">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/folder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="0.4"
                    android:hint="@string/folder" />

                <adco.helixsongview.customviews.MyMaterialEditText
                    android:id="@+id/filename"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="0.6"
                    android:hint="@string/filename"
                    app:endIconMode="clear_text" />
            </LinearLayout>
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <LinearLayout
                android:id="@+id/stickyNotesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Button to add a new sticky note -->
            <adco.helixsongview.customviews.MyExtendedFloatingActionButton
                android:id="@+id/addStickyNoteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                android:text="@string/new_something"
                app:icon="@drawable/plus" />

            <!--<adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/songNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/song_notes"
                android:imeOptions="actionNone"
                android:inputType="text|textMultiLine"
                android:lines="5"
                android:maxLines="5"
                android:minLines="5"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:endIconMode="clear_text" />
            -->
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp"
                android:text="@string/override_sticky" />

            <adco.helixsongview.customviews.TextThreeSlider
                android:id="@+id/overrideStickySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="0dp"
                android:layout_marginTop="0dp"
                app:textL="@string/override_none"
                app:textC="@string/override_on"
                app:textR="@string/override_off"/>
        </LinearLayout>
    </adco.helixsongview.customviews.ScrollViewWithFAB>
</LinearLayout>