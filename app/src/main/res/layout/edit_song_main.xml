<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <adco.helixsongview.customviews.ScrollViewWithFAB
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <LinearLayout
            android:id="@+id/resizeForKeyboardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingBottom="@dimen/extra_scroll_space_large">

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/title"
                app:endIconMode="clear_text" />

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/artist"
                app:endIconMode="clear_text" />

            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="top">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/folder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="0.4"
                    android:hint="@string/folder" />

                <adco.helixsongview.customviews.MyMaterialEditText
                    android:id="@+id/filename"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="0.6"
                    android:hint="@string/filename"
                    app:endIconMode="clear_text" />
            </LinearLayout>
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

        </LinearLayout>
    </adco.helixsongview.customviews.ScrollViewWithFAB>
</LinearLayout>