<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <adco.helixsongview.customviews.DialogHeader
        android:id="@+id/dialogHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/midi_action" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/songActionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/extra_scroll_space_large">

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/midiName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:hint="@string/title"/>
            <adco.helixsongview.customviews.MyDivider
                android:id="@+id/midiNameDivider"
                style="@style/MyDividerLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/midiChannel"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/midi_channel" />

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/midiCommand"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:hint="@string/action" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/midiValue1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/midi_value" />

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/midiValue2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/midi_value" />
            </LinearLayout>

            <adco.helixsongview.customviews.MyMaterialTextView
                android:id="@+id/midiShortHand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/midi_shorthand" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">
                <adco.helixsongview.customviews.MyMaterialButton
                    android:id="@+id/midiTest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/midi_test"
                    android:layout_margin="8dp"/>
                <adco.helixsongview.customviews.MyMaterialButton
                    android:id="@+id/midiAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text="@string/midi_add"/>
            </LinearLayout>
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/midi_list_item"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/extra_scroll_space_large"/>
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyExtendedFloatingActionButton
                android:id="@+id/addCommandButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_margin="8dp"
                android:text="@string/save"
                app:icon="@drawable/save"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
