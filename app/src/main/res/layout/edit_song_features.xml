<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <adco.helixsongview.customviews.ScrollViewWithFAB
        android:id="@+id/featuresScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <LinearLayout
            android:id="@+id/resizeForKeyboardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingBottom="@dimen/extra_scroll_space_large">

            <adco.helixsongview.customviews.MyMaterialButton
                android:id="@+id/searchOnline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/key"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:hint="@string/key" />

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/originalkey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:hint="@string/key_original" />

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/capo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:hint="@string/capo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/pad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:hint="@string/pad" />

                <adco.helixsongview.customviews.MyMaterialSwitch
                    android:id="@+id/loop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:text="@string/loop" />
            </LinearLayout>
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/tempo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:hint="@string/tempo"
                    android:inputType="number" />

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/timesig"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:hint="@string/time_signature" />
            </LinearLayout>


            <adco.helixsongview.customviews.MyMaterialButton
                android:id="@+id/tapTempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                android:text="@string/tap_tempo" />
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>


            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:text="@string/song_duration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <adco.helixsongview.customviews.MyMaterialEditText
                    android:id="@+id/durationMins"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:hint="@string/time_mins"
                    android:inputType="number"
                    app:suffixText="m"
                    android:importantForAutofill="no"/>

                <adco.helixsongview.customviews.MyMaterialSimpleTextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text=":"
                    tools:ignore="HardcodedText" />

                <adco.helixsongview.customviews.MyMaterialEditText
                    android:id="@+id/durationSecs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:hint="@string/time_secs"
                    android:inputType="number"
                    app:suffixText="s"
                    android:importantForAutofill="no"/>

                <adco.helixsongview.customviews.MyMaterialEditText
                    android:id="@+id/delay"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="22dp"
                    android:layout_weight="1.5"
                    android:hint="@string/autoscroll_time"
                    android:inputType="number"
                    app:suffixText="s"
                    android:importantForAutofill="no"/>
            </LinearLayout>
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/helperText"
                style="@style/helperText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/song_features_warning" />

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/midi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/midi_send"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <adco.helixsongview.customviews.MyMaterialEditText
                android:id="@+id/customChords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/custom_chords"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <adco.helixsongview.customviews.ExposedDropDown
                    android:id="@+id/linkType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="0.5"
                    android:hint="@string/link" />

                <adco.helixsongview.customviews.MyMaterialEditText
                    android:id="@+id/linkValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="0.5"
                    android:hint="@string/midi_value" />
            </LinearLayout>
        </LinearLayout>
    </adco.helixsongview.customviews.ScrollViewWithFAB>
</RelativeLayout>
