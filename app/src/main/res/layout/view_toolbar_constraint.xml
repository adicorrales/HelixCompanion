<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionBarBackground"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_gravity="start"
    android:background="@color/helix_matrix_bar"
    android:minHeight="?attr/actionBarSize"
    app:elevation="0dp">

    <LinearLayout
        android:id="@+id/songSourceButtons"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/helix_matrix_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/songSourceAll"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:layout_marginStart="1dp"
            android:background="@drawable/transport_btn_bg"
            android:gravity="center"
            android:minWidth="80dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="All"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songSourceHelix"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:layout_marginStart="1dp"
            android:background="@drawable/transport_btn_bg"
            android:gravity="center"
            android:minWidth="80dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Helix"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songSourceLocal"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:layout_marginStart="1dp"
            android:background="@drawable/transport_btn_bg"
            android:gravity="center"
            android:minWidth="80dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Local"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:paddingStart="56dp"
        android:paddingEnd="12dp"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batterySpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Horizontal Transport & Song Info Bar -->

    <Space
        android:id="@+id/batterySpace"
        android:layout_width="8dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batteryholder"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/batteryimage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/time"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/batteryholder"
        app:layout_constraintEnd_toEndOf="@+id/batteryholder"
        app:layout_constraintStart_toStartOf="@+id/batteryholder"
        app:layout_constraintTop_toTopOf="@+id/batteryholder" />

    <FrameLayout
        android:id="@+id/batteryholder"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/batterycharge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|bottom"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_xsmall"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/digitalclock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_weight="0.5"
            tools:text="100%" />

        <adco.helixsongview.customviews.SafeTextClock
            android:id="@+id/digitalclock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center_horizontal|top"
            android:includeFontPadding="false"
            android:maxWidth="50dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_xsmall"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/batterycharge"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_weight="0.5"
            tools:text="12:00" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
