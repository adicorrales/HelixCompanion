<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionBarBackground"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_gravity="start"
    android:background="@color/helix_matrix_bar"
    android:minHeight="?attr/actionBarSize"
    app:elevation="0dp">

    <LinearLayout
        android:id="@+id/songSourceButtons"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/helix_matrix_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batterySpace"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/songSourceAll"
            android:layout_width="68dp"
            android:layout_height="36dp"
            android:background="@drawable/transport_btn_bg"
            android:gravity="center"
            android:minWidth="68dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="All"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songSourceHelix"
            android:layout_width="68dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/transport_btn_bg"
            android:gravity="center"
            android:minWidth="68dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Helix"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songSourceLocal"
            android:layout_width="68dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/transport_btn_bg"
            android:gravity="center"
            android:minWidth="68dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Local"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:paddingStart="56dp"
        android:paddingEnd="12dp"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batterySpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/metronomeLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batterySpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/beat1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat11"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat12"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat13"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat14"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat15"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Main Horizontal Transport & Song Info Bar -->
    <LinearLayout
        android:id="@+id/transportAndSongBar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batterySpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Existing controls are retained for compatibility; the active transport is docked at screen bottom. -->
        <!-- 1. Prev Song Button (Framed) -->
        <LinearLayout
            android:id="@+id/btnTransportPrevContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/transport_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/btnTransportPrevArrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Prev"
                android:src="@drawable/arrow_left" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/btnTransportPrevTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:textSize="12sp"
                tools:text="Previous Song" />
        </LinearLayout>

        <!-- 2. Return to Zero Button (Wider, Framed) -->
        <ImageView
            android:id="@+id/btnTransportRt0"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/transport_btn_bg"
            android:clickable="true"
            android:contentDescription="Return to 0"
            android:focusable="true"
            android:padding="10dp"
            app:srcCompat="@drawable/refresh" />

        <!-- 3. Current Song & Artist (Framed) -->
        <LinearLayout
            android:id="@+id/songandauthor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="2.0"
            android:background="@drawable/transport_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/setIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/set"
                    android:visibility="gone"
                    app:srcCompat="@drawable/check" />

                <adco.helixsongview.customviews.MyMaterialSimpleTextView
                    android:id="@+id/songtitle_ab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Song Title" />

                <adco.helixsongview.customviews.MyMaterialSimpleTextView
                    android:id="@+id/songkey_ab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="12sp"
                    tools:text=" (Key)" />

                <adco.helixsongview.customviews.MyMaterialSimpleTextView
                    android:id="@+id/songcapo_ab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="12sp"
                    tools:text=" [Capo]" />

                <adco.helixsongview.customviews.MyMaterialSimpleTextView
                    android:id="@+id/songtempo_ab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="12sp"
                    tools:text=" 120bpm" />
            </LinearLayout>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songauthor_ab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp"
                tools:text="Artist" />
        </LinearLayout>

        <!-- 4. Independent Play/Pause Button (Framed, width weight = 2.0 matching title) -->
        <LinearLayout
            android:id="@+id/btnTransportPlayContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="2.0"
            android:background="@drawable/transport_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/playPauseIndicator"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Play/Pause"
                app:srcCompat="@drawable/play" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/playPauseStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="9sp"
                android:visibility="gone"
                tools:text="On Cue" />
        </LinearLayout>

        <!-- 5. Next Song Button -->
        <LinearLayout
            android:id="@+id/btnTransportNextContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/transport_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/btnTransportNextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:textSize="12sp"
                tools:text="Next Song" />

            <ImageView
                android:id="@+id/btnTransportNextArrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Next"
                android:src="@drawable/arrow_right" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:id="@+id/batterySpace"
        android:layout_width="8dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batteryholder"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/batteryimage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/time"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/batteryholder"
        app:layout_constraintEnd_toEndOf="@+id/batteryholder"
        app:layout_constraintStart_toStartOf="@+id/batteryholder"
        app:layout_constraintTop_toTopOf="@+id/batteryholder" />

    <FrameLayout
        android:id="@+id/batteryholder"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/batterycharge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|bottom"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_xsmall"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/digitalclock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_weight="0.5"
            tools:text="100%" />

        <adco.helixsongview.customviews.SafeTextClock
            android:id="@+id/digitalclock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center_horizontal|top"
            android:includeFontPadding="false"
            android:maxWidth="50dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_xsmall"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/batterycharge"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_weight="0.5"
            tools:text="12:00" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
