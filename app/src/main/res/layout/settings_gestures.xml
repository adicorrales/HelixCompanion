<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/DefaultView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/extra_scroll_space_large">

            <adco.helixsongview.customviews.MyMaterialSwitch
                android:id="@+id/allowPinchToZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pinch_to_zoom"
                android:hint="@string/pinch_to_zoom_info"/>
            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/double_tap" />

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/doubleTap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/action" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/long_press_action" />

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/longPress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="400dp"
                android:hint="@string/action" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>