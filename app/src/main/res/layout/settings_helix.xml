<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DefaultView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="@dimen/extra_scroll_space_large">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Note: Helix must have MIDI Through enabled to communicate with the app."
                android:textColor="?attr/hintTextColor"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Song Selection Mode (Skip / Cue)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/helixSongMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Song Play Mode (Play / Load)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/helixPlayMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Helix Global MIDI Channel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/helixGlobalMidiChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bypass / Ctrl MIDI Channel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/helixChannelBypassCtrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matrix 1/4 inch MIDI Channel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/helixChannelMatrixQuarter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matrix XLR MIDI Channel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/helixChannelMatrixXlr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <adco.helixsongview.customviews.MyDivider
                style="@style/MyDividerLine"/>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matrix Phones MIDI Channel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <adco.helixsongview.customviews.ExposedDropDown
                android:id="@+id/helixChannelMatrixPhones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
