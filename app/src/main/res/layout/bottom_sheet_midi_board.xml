<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <adco.helixsongview.customviews.DialogHeader
        android:id="@+id/dialogHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/midi_action" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/extra_scroll_space">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <adco.helixsongview.customviews.MyMaterialButton
                    android:id="@+id/boardPage1"
                    style="@style/LeftButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="page 1"
                    android:padding="0dp"
                    android:text="@string/number_1"
                    tools:ignore="HardcodedText" />

                <adco.helixsongview.customviews.MyMaterialButton
                    android:id="@+id/boardPage2"
                    style="@style/MiddleButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="page 2"
                    android:padding="0dp"
                    android:text="@string/number_2"
                    tools:ignore="HardcodedText" />

                <adco.helixsongview.customviews.MyMaterialButton
                    android:id="@+id/boardPage3"
                    style="@style/RightButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="page 3"
                    android:padding="0dp"
                    android:text="@string/number_3"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <adco.helixsongview.customviews.MyDivider style="@style/MyDividerLine" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/boardTitle"
                style="@style/largeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/title" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="460dp"
                        android:layout_marginBottom="4dp"
                        android:columnCount="2"
                        android:rowCount="4">

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton1"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="1"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton2"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="2"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton3"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="3"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton4"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="4"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton5"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="5"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton6"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="6"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton7"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="7"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />

                        <adco.helixsongview.customviews.MyMaterialButton
                            android:id="@+id/boardButton8"
                            android:layout_width="104dp"
                            android:layout_height="102dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:contentDescription="8"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:padding="2dp"
                            android:textSize="@dimen/text_xsmall"
                            app:layout_columnWeight="1"
                            tools:ignore="HardcodedText" />
                    </GridLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <adco.helixsongview.customviews.MidiSlider
                            android:id="@+id/boardSlider1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:padding="4dp" />

                        <adco.helixsongview.customviews.MidiSlider
                            android:id="@+id/boardSlider2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:padding="4dp" />

                        <adco.helixsongview.customviews.MidiSlider
                            android:id="@+id/boardSlider3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:padding="4dp" />

                        <adco.helixsongview.customviews.MidiSlider
                            android:id="@+id/boardSlider4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:padding="4dp" />

                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/midi_board_click_or_long_click" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>