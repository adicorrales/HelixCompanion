<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transportBar"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@color/helix_matrix_transport_bar">

    <LinearLayout
        android:id="@+id/btnTransportPrevContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:layout_margin="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/btnTransportPrevArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/transport_skip_previous"
            android:contentDescription="Previous song"
            app:tint="#E2E8F0" />

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/btnTransportPrevTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="start|center_vertical"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            tools:text="Previous" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnTransportRt0"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Return to start"
        android:padding="11dp"
        app:tint="#E2E8F0"
        app:srcCompat="@drawable/refresh" />

    <LinearLayout
        android:id="@+id/songandauthor"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_margin="4dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/setIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone"
                android:contentDescription="@string/set"
                app:srcCompat="@drawable/check" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songtitle_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Song title" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songkey_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                tools:text=" (Key)" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songcapo_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                tools:text=" [Capo]" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songtempo_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                tools:text=" 120 bpm" />
        </LinearLayout>

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/songauthor_ab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            tools:text="Artist" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTransportPlayContainer"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/playPauseIndicator"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:srcCompat="@drawable/play"
            android:contentDescription="Play or pause"
            app:tint="#E2E8F0" />

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/playPauseStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="On Cue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTransportNextContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:layout_margin="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true">

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/btnTransportNextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="end|center_vertical"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            tools:text="Next" />

        <ImageView
            android:id="@+id/btnTransportNextArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/transport_skip_next"
            android:contentDescription="Next song"
            app:tint="#E2E8F0" />
    </LinearLayout>
</LinearLayout>
