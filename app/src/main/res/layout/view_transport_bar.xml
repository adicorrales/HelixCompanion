<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transportBar"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@color/helix_matrix_transport_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/btnTransportPrevContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1.25"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageView
            android:id="@+id/btnTransportPrevArrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Previous song"
            android:src="@drawable/transport_skip_previous"
            app:tint="#E2E8F0" />

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/btnTransportPrevTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            tools:text="Previous" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnTransportRt0"
        android:layout_width="62dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:contentDescription="Return to start"
        android:focusable="true"
        android:padding="4dp"
        app:srcCompat="@drawable/refresh"
        app:tint="#E2E8F0" />

    <LinearLayout
        android:id="@+id/songandauthor"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="2"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/setIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@string/set"
                android:visibility="gone"
                app:srcCompat="@drawable/check" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songtitle_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Song title" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songkey_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                tools:text=" (Key)" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songcapo_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                tools:text=" [Capo]" />

            <adco.helixsongview.customviews.MyMaterialSimpleTextView
                android:id="@+id/songtempo_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                tools:text=" 120 bpm" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTransportPlayContainer"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/playPauseIndicator"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:contentDescription="Play or pause"
            app:srcCompat="@drawable/play"
            app:tint="#E2E8F0" />

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/playPauseStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:visibility="visible"
            tools:text="On Cue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTransportNextContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1.25"
        android:background="@drawable/transport_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <adco.helixsongview.customviews.MyMaterialSimpleTextView
            android:id="@+id/btnTransportNextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            tools:text="Next" />

        <ImageView
            android:id="@+id/btnTransportNextArrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Next song"
            android:src="@drawable/transport_skip_next"
            app:tint="#E2E8F0" />
    </LinearLayout>
</LinearLayout>
