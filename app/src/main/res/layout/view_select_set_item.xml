<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Set number column -->
    <com.garethevans.church.opensongtablet.customviews.MyMaterialSimpleTextView
        android:id="@+id/select_set_number"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="0:" />

    <!-- Card containing set name and checkbox -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/select_set_card"
        style="@style/setItem"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp">

        <RelativeLayout
            android:id="@+id/select_set_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp">

            <com.garethevans.church.opensongtablet.customviews.MyMaterialCheckbox
                android:id="@+id/select_set_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="8dp" />

            <com.garethevans.church.opensongtablet.customviews.MyMaterialSimpleTextView
                android:id="@+id/select_set_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/select_set_checkbox"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="0dp"
                android:text="Title"
                android:textSize="14sp"
                android:visibility="visible"/>

            <com.garethevans.church.opensongtablet.customviews.MyMaterialSimpleTextView
                android:id="@+id/select_set_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/select_set_checkbox"
                android:layout_below="@+id/select_set_title"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingTop="0dp"
                android:paddingEnd="4dp"
                android:paddingBottom="2dp"
                android:text="Folder"
                android:textSize="11sp" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
