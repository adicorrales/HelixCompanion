<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bb_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <adco.helixsongview.customviews.MyMaterialSimpleTextView
        android:id="@+id/bb_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_medium"
        tools:text="@string/folder" />

    <adco.helixsongview.customviews.MyMaterialSimpleTextView
        android:id="@+id/bb_song"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_medium"
        tools:text="@string/song" />

    <adco.helixsongview.customviews.MyMaterialSimpleTextView
        android:id="@+id/bb_timesig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_medium"
        tools:text="@string/time_signature" />

    <adco.helixsongview.customviews.MyMaterialSimpleTextView
        android:id="@+id/bb_kit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_medium"
        tools:text="@string/drum_kit" />

    <adco.helixsongview.customviews.MyDivider
        style="@style/MyDividerLine"/>
</LinearLayout>